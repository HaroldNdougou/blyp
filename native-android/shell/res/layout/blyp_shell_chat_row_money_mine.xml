<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="56dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/blyp_chat_reply_quote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="4dp"
        android:background="@color/blyp_shell_surface_muted"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="@color/blyp_shell_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/blyp_chat_money_bubble"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:background="@drawable/blyp_shell_cash_bubble"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/blyp_chat_money_fruit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="42sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/blyp_chat_money_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="@string/blyp_shell_chat_cash"
                android:textColor="@color/blyp_shell_cash_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/blyp_chat_money_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/blyp_shell_cash_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_chat_money_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/blyp_shell_cash_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/blyp_chat_money_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/blyp_shell_cash_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/blyp_chat_money_receipt_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/blyp_shell_cash_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/blyp_chat_money_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textColor="@color/blyp_shell_cash_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <include layout="@layout/blyp_shell_chat_time_row" />

        <TextView
            android:id="@+id/blyp_chat_reactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/blyp_shell_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>