<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BlypColdKey" parent="android:Widget.TextView">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">@drawable/blyp_cold_key_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/blyp_cold_start_key_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="BlypColdKeyFn" parent="BlypColdKey">
        <item name="android:background">@drawable/blyp_cold_key_fn</item>
        <item name="android:textColor">@color/blyp_cold_start_keypad_icon</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="BlypColdKeyPay" parent="BlypColdKey">
        <item name="android:background">@drawable/blyp_cold_key_pay</item>
        <item name="android:textColor">@color/blyp_cold_start_accent_on</item>
    </style>

    <style name="BlypColdKeyRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="BlypColdQuickChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/blyp_cold_quick_chip</item>
        <item name="android:textColor">@color/blyp_cold_start_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BlypColdRecipientName">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/blyp_cold_start_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BlypColdRecipientPhone">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/blyp_cold_start_text_muted</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
