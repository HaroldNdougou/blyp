<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/blyp_shell_messages_press"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/blyp_messages_peer_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/blyp_shell_avatar_circle"
            android:gravity="center"
            android:textColor="@color/blyp_shell_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/blyp_messages_peer_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/blyp_shell_avatar_circle"
            android:contentDescription="@string/blyp_shell_profile_avatar_a11y"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/blyp_messages_peer_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/blyp_shell_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_messages_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/blyp_messages_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/blyp_shell_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/blyp_messages_unread"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/blyp_shell_unread_dot"
                android:text=""
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
