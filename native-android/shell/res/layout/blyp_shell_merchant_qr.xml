<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/blyp_merchant_qr_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/blyp_shell_scan_back"
            android:padding="12dp"
            android:src="@drawable/blyp_shell_ic_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/blyp_shell_commerce_qr_title"
            android:textColor="@color/blyp_shell_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/blyp_merchant_qr_image"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/blyp_shell_commerce_recent_card"
            android:contentDescription="@string/blyp_shell_commerce_qr_title"
            android:padding="14dp"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/blyp_shell_commerce_qr_amount_hint"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <EditText
                android:id="@+id/blyp_merchant_qr_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textColorHighlight="@android:color/transparent"
                android:hint="0"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="number"
                android:letterSpacing="-0.01"
                android:maxLength="6"
                android:minWidth="48dp"
                android:textColor="@color/blyp_shell_text"
                android:textColorHint="@color/blyp_shell_text_faint"
                android:textCursorDrawable="@drawable/blyp_shell_amount_cursor"
                android:textSelectHandle="@drawable/blyp_shell_amount_handle"
                android:textSelectHandleLeft="@drawable/blyp_shell_amount_handle"
                android:textSelectHandleRight="@drawable/blyp_shell_amount_handle"
                android:textSize="50sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:includeFontPadding="false"
                android:text="F"
                android:textColor="@color/blyp_shell_text_faint"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/blyp_merchant_qr_brightness_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/blyp_shell_commerce_qr_brightness"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/blyp_merchant_qr_brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:progress="0"
            android:progressTint="@color/blyp_shell_accent"
            android:thumbTint="@color/blyp_shell_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/blyp_shell_commerce_qr_hint"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/blyp_merchant_qr_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:text="@string/blyp_shell_detail_close"
            android:textColor="@color/blyp_shell_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
