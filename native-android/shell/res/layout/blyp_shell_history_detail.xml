<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="100dp">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/blyp_shell_summary_card_active"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/blyp_shell_accent"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/blyp_shell_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_detail_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/blyp_shell_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/blyp_detail_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textColor="@color/blyp_shell_accent"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/blyp_shell_history_fcfa"
                android:textColor="@color/blyp_shell_text_faint"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/blyp_shell_history_row_bg"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp">

                    <TextView
                        android:id="@+id/blyp_detail_peer_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/blyp_shell_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/blyp_detail_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/blyp_shell_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blyp_shell_border_light" />

                <LinearLayout
                    android:id="@+id/blyp_detail_phone_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/blyp_shell_detail_phone"
                        android:textColor="@color/blyp_shell_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/blyp_detail_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/blyp_shell_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/blyp_detail_phone_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blyp_shell_border_light"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/blyp_shell_detail_date"
                        android:textColor="@color/blyp_shell_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/blyp_detail_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/blyp_shell_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blyp_shell_border_light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/blyp_shell_detail_status"
                        android:textColor="@color/blyp_shell_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/blyp_shell_detail_status_ok"
                        android:textColor="@color/blyp_shell_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blyp_shell_border_light" />

                <LinearLayout
                    android:id="@+id/blyp_detail_balance_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/blyp_shell_detail_balance"
                        android:textColor="@color/blyp_shell_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/blyp_detail_balance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/blyp_shell_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/blyp_detail_ref_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blyp_shell_border_light"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/blyp_detail_ref_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="7dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/blyp_shell_detail_ref"
                        android:textColor="@color/blyp_shell_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/blyp_detail_ref"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/blyp_shell_text"
                        android:textIsSelectable="true"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/blyp_detail_share"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/blyp_shell_menu_row_btn"
        android:gravity="center"
        android:text="@string/blyp_shell_detail_share"
        android:textColor="@color/blyp_shell_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/blyp_detail_close"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/blyp_shell_filter_chip_selected"
        android:gravity="center"
        android:text="@string/blyp_shell_detail_ok"
        android:textColor="@color/blyp_shell_accent_on"
        android:textSize="16sp"
        android:textStyle="bold" />
</FrameLayout>
