<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/blyp_shell_menu_row_btn"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/blyp_commerce_switch_row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/blyp_shell_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blyp_commerce_switch_row_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/blyp_shell_deposit_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/blyp_shell_commerce_active_badge"
            android:textColor="@color/blyp_shell_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/blyp_commerce_switch_row_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/blyp_shell_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/blyp_commerce_switch_row_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/blyp_shell_text"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
