<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/blyp_profile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:text="@string/blyp_shell_tab_profile"
            android:textColor="@color/blyp_shell_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blyp_profile_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/blyp_shell_profile_subtitle"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:id="@+id/blyp_profile_avatar_wrap"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/blyp_shell_avatar_hero"
                android:clickable="true"
                android:contentDescription="@string/blyp_shell_profile_change_photo"
                android:focusable="true">

                <ImageView
                    android:id="@+id/blyp_profile_avatar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/blyp_shell_profile_avatar_a11y"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/blyp_profile_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/blyp_shell_accent"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/blyp_profile_avatar_busy"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/blyp_shell_overlay"
                    android:visibility="gone">

                    <ProgressBar
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/blyp_shell_accent" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/blyp_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxWidth="260dp"
                    android:maxLines="2"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/blyp_profile_edit_name"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/blyp_shell_profile_edit_name"
                    android:padding="4dp"
                    android:src="@drawable/blyp_shell_ic_pencil"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/blyp_profile_status_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/blyp_shell_chip_ok"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/blyp_shell_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/blyp_profile_onboarding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/blyp_shell_onboarding_banner"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="@string/blyp_shell_profile_onboarding_hint"
            android:textColor="@color/blyp_shell_destructive"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/blyp_profile_balance_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/blyp_shell_section_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/blyp_profile_balance_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="@string/blyp_shell_profile_balance_label"
                android:textAllCaps="true"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_profile_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:textColor="@color/blyp_shell_text_secondary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blyp_shell_history_fcfa"
                    android:textColor="@color/blyp_shell_text_faint"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_profile_commerce_withdraw"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/blyp_shell_btn_secondary_pill"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="@string/blyp_shell_profile_action_withdraw"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blyp_profile_balance_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/blyp_profile_top_up"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/blyp_shell_btn_primary_pill"
                    android:gravity="center"
                    android:text="@string/blyp_shell_profile_action_top_up"
                    android:textColor="@color/blyp_shell_accent_on"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_profile_withdraw"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/blyp_shell_btn_secondary_pill"
                    android:gravity="center"
                    android:text="@string/blyp_shell_profile_action_withdraw"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/blyp_profile_section_commerces"
            style="@style/BlypShellProfileSection"
            android:text="@string/blyp_shell_profile_section_commerces" />

        <LinearLayout
            android:id="@+id/blyp_profile_commerces_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/blyp_shell_section_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/blyp_profile_commerces_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/blyp_profile_commerces_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingVertical="8dp"
                android:text="@string/blyp_shell_commerce_empty_hint"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/blyp_profile_create_commerce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/blyp_shell_commerce_create_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="@string/blyp_shell_commerce_create_open"
                android:textColor="@color/blyp_shell_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/BlypShellProfileSection"
            android:text="@string/blyp_shell_profile_section_nearby" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/blyp_shell_section_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/blyp_profile_broadcast_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/blyp_shell_profile_broadcast_label"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blyp_profile_broadcast_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/blyp_shell_border_light"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/blyp_profile_announce_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/blyp_shell_settings_announce_label"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blyp_profile_announce_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/blyp_shell_border_light"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/blyp_profile_small_pay_row"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/blyp_shell_profile_small_pay_label"
                        android:textColor="@color/blyp_shell_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/blyp_shell_profile_small_pay_hint"
                        android:textColor="@color/blyp_shell_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blyp_profile_small_pay_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/blyp_shell_border_light" />

            <LinearLayout
                android:id="@+id/blyp_profile_quick_pay_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/blyp_shell_profile_quick_pay_label"
                        android:textColor="@color/blyp_shell_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blyp_profile_quick_pay_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/blyp_shell_border_light" />

            <LinearLayout
                android:id="@+id/blyp_profile_ble_pay_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/blyp_shell_profile_ble_pay_label"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blyp_profile_ble_pay_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/blyp_shell_border_light" />

            <LinearLayout
                android:id="@+id/blyp_profile_warm_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/blyp_shell_profile_warm_open_label"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blyp_profile_warm_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/BlypShellProfileSection"
            android:text="@string/blyp_shell_profile_section_docs" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/blyp_shell_section_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/blyp_profile_documents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/blyp_shell_profile_documents"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/blyp_shell_ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/blyp_shell_border_light" />

            <LinearLayout
                android:id="@+id/blyp_profile_receipts_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/blyp_shell_profile_receipts"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_profile_receipts_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/blyp_shell_messages_badge_bg"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/blyp_shell_accent_on"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/blyp_shell_ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/blyp_profile_section_account"
                style="@style/BlypShellProfileSection"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="0dp"
                android:text="@string/blyp_shell_profile_section_account" />

            <ImageView
                android:id="@+id/blyp_profile_edit_account"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/blyp_shell_profile_edit_account"
                android:padding="6dp"
                android:src="@drawable/blyp_shell_ic_pencil" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/blyp_shell_section_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blyp_shell_profile_phone"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_profile_phone_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/blyp_shell_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/blyp_shell_border_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blyp_shell_profile_full_name"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_profile_name_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/blyp_shell_border_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blyp_shell_profile_account_id"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_profile_id_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textIsSelectable="true"
                    android:textColor="@color/blyp_shell_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/BlypShellProfileSection"
            android:text="@string/blyp_shell_profile_section_security" />

        <LinearLayout
            android:id="@+id/blyp_profile_kyc_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/blyp_profile_kyc_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/blyp_shell_kyc_pending"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="@string/blyp_shell_profile_kyc_pending"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/blyp_profile_kyc_cta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/blyp_shell_kyc_btn"
                android:gravity="center"
                android:text="@string/blyp_shell_kyc_verify"
                android:textColor="@color/blyp_shell_accent_on"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_profile_kyc_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:text="@string/blyp_shell_profile_kyc_lead"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/blyp_profile_plus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/blyp_shell_menu_row_btn"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="@string/blyp_shell_plus_open"
            android:textColor="@color/blyp_shell_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blyp_profile_change_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/blyp_shell_menu_row_btn"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="@string/blyp_shell_profile_change_pin"
            android:textColor="@color/blyp_shell_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blyp_profile_sign_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/blyp_shell_sign_out_btn"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="@string/blyp_shell_profile_sign_out"
            android:textColor="@color/blyp_shell_destructive"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blyp_profile_open_rn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/blyp_shell_sign_out_btn"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="@string/blyp_shell_profile_open_rn"
            android:textColor="@color/blyp_shell_destructive"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blyp_shell_profile_app_name"
                android:textColor="@color/blyp_shell_text_faint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_profile_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/blyp_shell_text_faint"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
