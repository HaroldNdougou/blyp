<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/blyp_kyc_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/blyp_shell_scan_back"
                android:padding="12dp"
                android:src="@drawable/blyp_shell_ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/blyp_shell_kyc_title"
                android:textColor="@color/blyp_shell_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/blyp_kyc_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/blyp_shell_deposit_bg"
            android:padding="16dp"
            android:textColor="@color/blyp_shell_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/blyp_kyc_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/blyp_shell_kyc_body"
            android:textColor="@color/blyp_shell_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/blyp_kyc_primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/blyp_shell_filter_chip_selected"
            android:gravity="center"
            android:text="@string/blyp_shell_kyc_cta"
            android:textColor="@color/blyp_shell_accent_on"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
