<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blyp_chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/blyp_chat_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/blyp_shell_scan_back"
            android:padding="8dp"
            android:src="@drawable/blyp_shell_ic_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="56dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/blyp_chat_peer_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/blyp_shell_avatar_circle"
                    android:contentDescription="@string/blyp_shell_profile_avatar_a11y"
                    android:scaleType="centerCrop"
                    android:src="@drawable/blyp_shell_contact_placeholder" />

                <View
                    android:id="@+id/blyp_chat_online"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/blyp_shell_presence_dot"
                    android:contentDescription="@string/blyp_shell_chat_online"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/blyp_chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/blyp_shell_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_chat_last_seen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/blyp_chat_typing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/blyp_shell_chat_typing"
                android:textColor="@color/blyp_shell_accent"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/blyp_chat_busy"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/blyp_shell_accent"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/blyp_chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <ImageView
            android:id="@+id/blyp_chat_jump"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/blyp_shell_jump_circle"
            android:contentDescription="@string/blyp_shell_chat_jump"
            android:elevation="4dp"
            android:padding="8dp"
            android:src="@drawable/blyp_shell_ic_down"
            android:tint="@color/blyp_shell_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blyp_chat_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/blyp_shell_day_chip"
            android:elevation="2dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/blyp_shell_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/blyp_chat_reply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blyp_shell_surface_muted"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/blyp_chat_reply_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/blyp_shell_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/blyp_chat_reply_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/blyp_shell_chat_reply_cancel"
            android:textColor="@color/blyp_shell_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:id="@+id/blyp_chat_pending_photos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/blyp_chat_pending_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/blyp_chat_emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scrollbars="none"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/blyp_chat_emoji_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="8"
                android:paddingBottom="8dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/blyp_chat_voice_wrap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/blyp_shell_voice_screen"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:id="@+id/blyp_chat_voice_lock"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:layout_marginBottom="6dp"
                android:background="@drawable/blyp_shell_voice_knob"
                android:gravity="center"
                android:text="↑"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/blyp_chat_voice_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/blyp_shell_voice_screen"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/blyp_chat_voice_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/blyp_shell_chat_voice_title"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/blyp_chat_voice_clock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="00:00:00"
                    android:textColor="@android:color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/blyp_chat_voice_effects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/blyp_chat_voice_effect_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/blyp_chat_voice_delete"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/blyp_shell_voice_orange"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="×"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/blyp_chat_voice_action"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginHorizontal="28dp"
                        android:background="@drawable/blyp_shell_voice_white_circle"
                        android:contentDescription="@string/blyp_shell_chat_voice_play_failed"
                        android:padding="20dp"
                        android:src="@drawable/blyp_shell_voice_pause"
                        android:tint="@color/blyp_shell_voice_screen" />

                    <ImageView
                        android:id="@+id/blyp_chat_voice_send"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/blyp_shell_voice_ring"
                        android:contentDescription="@string/blyp_shell_chat_send"
                        android:padding="10dp"
                        android:src="@drawable/blyp_shell_ic_send"
                        android:tint="@android:color/white"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:id="@+id/blyp_chat_voice_dot"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <com.haroldndougou.blyp.shell.BlypShellVoiceWaveView
                    android:id="@+id/blyp_chat_voice_wave"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <SeekBar
                    android:id="@+id/blyp_chat_voice_scrub"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:max="1000"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/blyp_chat_voice_resume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingTop="6dp"
                android:text="@string/blyp_shell_chat_voice_resume"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/blyp_chat_input_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

            <EditText
                android:id="@+id/blyp_chat_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blyp_shell_chat_input_bg"
                android:gravity="top|start"
                android:hint="@string/blyp_shell_chat_input_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="44dp"
                android:paddingStart="14dp"
                android:paddingEnd="40dp"
                android:paddingVertical="10dp"
                android:textColor="@color/blyp_shell_text"
                android:textColorHint="@color/blyp_shell_hint"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/blyp_chat_emoji"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/blyp_shell_chat_emoji"
                android:padding="4dp"
                android:src="@drawable/blyp_shell_ic_emoji"
                android:tint="@color/blyp_shell_hint" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/blyp_chat_send_hit"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:clickable="true"
                android:contentDescription="@string/blyp_shell_chat_send"
                android:focusable="true">

                <ImageView
                    android:id="@+id/blyp_chat_send"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/blyp_shell_send_circle"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/blyp_shell_ic_send" />

                <ProgressBar
                    android:id="@+id/blyp_chat_send_spin"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/blyp_shell_chat_sending"
                    android:indeterminate="true"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="2dp">

            <LinearLayout
                android:id="@+id/blyp_chat_money"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/blyp_shell_chat_money_a11y"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/blyp_chat_money_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/blyp_shell_ic_money"
                    android:tint="@color/blyp_shell_text" />

                <TextView
                    android:id="@+id/blyp_chat_money_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/blyp_shell_chat_label_money"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blyp_chat_nearby"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <FrameLayout
                        android:id="@+id/blyp_chat_nearby_circle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/blyp_shell_chat_nearby_circle">

                        <TextView
                            android:id="@+id/blyp_chat_nearby_initial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="?"
                            android:textColor="@color/blyp_shell_muted"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Au-dessus de l’initiale : dès que la PP est visible, le P disparaît -->
                        <ImageView
                            android:id="@+id/blyp_chat_nearby_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/blyp_chat_nearby_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/blyp_chat_nearby_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="8sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/blyp_chat_nearby_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/blyp_shell_chat_nearby_none"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blyp_chat_mic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/blyp_shell_chat_voice_a11y"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/blyp_chat_mic_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/blyp_shell_ic_mic"
                    android:tint="@color/blyp_shell_text" />

                <TextView
                    android:id="@+id/blyp_chat_mic_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/blyp_shell_chat_label_voice"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blyp_chat_more"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/blyp_shell_chat_label_more"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/blyp_chat_more_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/blyp_shell_ic_plus"
                    android:tint="@color/blyp_shell_text" />

                <TextView
                    android:id="@+id/blyp_chat_more_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/blyp_shell_chat_label_more"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>