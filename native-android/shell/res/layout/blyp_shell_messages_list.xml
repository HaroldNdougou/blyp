<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/blyp_shell_messages_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/blyp_shell_messages_title"
            android:textColor="@color/blyp_shell_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/blyp_shell_messages_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/blyp_shell_messages_delete"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/blyp_shell_ic_trash_muted"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/blyp_shell_messages_compose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/blyp_shell_messages_new_chat"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/blyp_shell_ic_compose" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/blyp_shell_messages_swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/blyp_shell_messages_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                android:scrollbars="none" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/blyp_shell_messages_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/blyp_shell_messages_empty_cta"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/blyp_shell_btn_primary_pill"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:text="@string/blyp_shell_messages_new_chat"
                android:textColor="@color/blyp_shell_accent_on"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
