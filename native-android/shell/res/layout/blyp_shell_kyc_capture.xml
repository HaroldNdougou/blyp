<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <ImageView
        android:id="@+id/blyp_kyc_cap_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:layout_marginStart="-12dp"
        android:contentDescription="@string/blyp_shell_scan_back"
        android:padding="12dp"
        android:src="@drawable/blyp_shell_ic_back" />

    <TextView
        android:id="@+id/blyp_kyc_cap_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/blyp_shell_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/blyp_kyc_cap_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/blyp_shell_text_secondary"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/blyp_kyc_cap_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@drawable/blyp_shell_filter_chip"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/blyp_kyc_cap_primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/blyp_shell_filter_chip_selected"
        android:gravity="center"
        android:textColor="@color/blyp_shell_accent_on"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
