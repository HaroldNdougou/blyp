<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0.5dp"
        android:top="1dp"
        android:right="0.5dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/blyp_shell_surface" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/blyp_shell_border" />
        </shape>
    </item>
</layer-list>
