<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/blyp_shell_menu_row_btn"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/blyp_soa_report_trip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/blyp_shell_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/blyp_soa_report_trip_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/blyp_shell_muted"
        android:textSize="13sp" />

</LinearLayout>
