<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/blyp_chat_reply_quote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="4dp"
        android:background="@color/blyp_shell_surface_muted"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="@color/blyp_shell_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:gravity="bottom"
        android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/blyp_chat_voice_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/blyp_shell_chat_bubble_mine"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="7dp">

        <TextView
            android:id="@+id/blyp_chat_voice_speed"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="@string/blyp_shell_chat_voice_rate_1"
            android:textColor="@color/blyp_shell_bubble_mine_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/blyp_chat_voice_play"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/blyp_shell_chat_voice_a11y"
            android:padding="6dp"
            android:src="@drawable/blyp_shell_voice_play" />

        <com.haroldndougou.blyp.shell.BlypShellVoiceWaveView
            android:id="@+id/blyp_chat_voice_wave_bars"
            android:layout_width="168dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/blyp_chat_voice_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/blyp_shell_bubble_mine_text"
            android:textSize="12sp" />
    </LinearLayout>

    </LinearLayout>

    <include layout="@layout/blyp_shell_chat_time_row" />
</LinearLayout>