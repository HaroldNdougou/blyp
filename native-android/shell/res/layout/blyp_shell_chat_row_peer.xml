<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="1dp"
    android:paddingEnd="56dp"
    android:paddingBottom="1dp">

    <TextView
        android:id="@+id/blyp_chat_reply_quote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@color/blyp_shell_surface_muted"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="@color/blyp_shell_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.haroldndougou.blyp.shell.BlypShellTightBubble
            android:id="@+id/blyp_chat_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="@drawable/blyp_shell_chat_bubble_peer"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/blyp_shell_bubble_peer_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/blyp_chat_reactions"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/blyp_shell_react_chip"
            android:elevation="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="24dp"
            android:paddingHorizontal="5dp"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/blyp_chat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/blyp_chat_meta_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/blyp_shell_chat_meta_delete_a11y"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/blyp_shell_ic_trash"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blyp_chat_seen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
