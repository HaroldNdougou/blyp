{
  "expo": {
    "name": "Blyp Pay",
    "slug": "blyp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-mark-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "blyp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haroldndougou.blyp",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Blyp utilise le Bluetooth pour détecter les taxis à proximité.",
        "NSLocationWhenInUseUsageDescription": "La localisation est requise sur Android pour le scan Bluetooth à proximité.",
        "NSMicrophoneUsageDescription": "Blyp utilise le micro pour les messages vocaux.",
        "NSContactsUsageDescription": "Blyp accède à vos contacts pour démarrer une conversation."
      },
      "splash": {
        "image": "./assets/images/splash-mark-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/splash-mark-dark.png",
          "backgroundColor": "#0B0B0C",
          "resizeMode": "contain"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5dc705",
        "foregroundImage": "./assets/images/icon.png"
      },
      "backgroundColor": "#ffffff",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.haroldndougou.blyp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WAKE_LOCK"
      ],
      "splash": {
        "image": "./assets/images/splash-mark-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/splash-mark-dark.png",
          "backgroundColor": "#0B0B0C",
          "resizeMode": "contain"
        }
      }
    },
    "plugins": [
      "expo-localization",
      [
        "expo-contacts",
        {
          "contactsPermission": "Blyp accède à vos contacts pour démarrer une conversation, comme sur WhatsApp."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Blyp utilise le micro pour les messages vocaux."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Blyp accède à vos photos pour les envoyer dans le chat.",
          "cameraPermission": "Blyp utilise l’appareil photo pour vérifier votre identité et envoyer des images."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Blyp accède à vos photos récentes pour publier un statut.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5dc705",
          "defaultChannel": "payments",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-mark-dark.png",
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central", "peripheral"],
          "bluetoothAlwaysPermission": "Blyp utilise le Bluetooth pour détecter les taxis à proximité."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Blyp utilise la localisation pour le scan Bluetooth des taxis à proximité (requis sur Android)."
        }
      ],
      "./plugins/withBleBroadcastForeground.js",
      "./plugins/withPaymentAnnounceBackground.js",
      "./plugins/withReadContacts.js",
      "./plugins/withGalleryMediaPermissions.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5a25b2ac-490a-4328-bc6a-5daf01f1bcf0"
      }
    },
    "owner": "haroldndougou"
  }
}
