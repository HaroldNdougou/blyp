<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/blyp_soa_online_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/blyp_soa_withdraw"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/blyp_shell_btn_secondary_pill"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="@string/blyp_shell_profile_action_withdraw"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_soa_online_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blyp_soa_online_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/blyp_shell_soa_trip_total_label"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/blyp_soa_trip_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/blyp_shell_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/blyp_shell_soa_seat_map_hint"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/blyp_soa_seat_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/blyp_soa_export_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/blyp_shell_filter_chip"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="@string/blyp_shell_soa_export_day"
                android:textColor="@color/blyp_shell_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_soa_period_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/blyp_shell_filter_chip"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="@string/blyp_shell_soa_period_report"
                android:textColor="@color/blyp_shell_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_soa_new_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/blyp_shell_menu_row_btn"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:text="@string/blyp_shell_soa_new_trip"
                android:textColor="@color/blyp_shell_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_soa_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/blyp_soa_flash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/blyp_shell_surface"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blyp_shell_commerce_received_title"
                android:textColor="@color/blyp_shell_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blyp_soa_flash_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/blyp_shell_success_amount"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/blyp_shell_history_fcfa"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
