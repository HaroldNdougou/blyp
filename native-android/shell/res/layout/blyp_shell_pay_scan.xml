<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_scan_bg">

    <FrameLayout
        android:id="@+id/blyp_scan_camera_wrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blyp_shell_scan_bg">

        <androidx.camera.view.PreviewView
            android:id="@+id/blyp_scan_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/blyp_scan_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/blyp_shell_scan_back"
            android:padding="12dp"
            android:src="@drawable/blyp_shell_ic_back"
            android:tint="@color/blyp_shell_scan_text" />

        <TextView
            android:id="@+id/blyp_scan_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="80dp"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:shadowColor="@color/blyp_shell_scan_shadow"
            android:shadowRadius="6"
            android:text="@string/blyp_shell_scan_hint"
            android:textColor="@color/blyp_shell_scan_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/blyp_scan_torch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="96dp"
            android:background="@drawable/blyp_shell_scan_round"
            android:contentDescription="@string/blyp_shell_scan_torch_on"
            android:padding="16dp"
            android:src="@drawable/blyp_shell_scan_torch_off"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blyp_scan_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/blyp_shell_scan_pill"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@android:string/cancel"
            android:textColor="@color/blyp_shell_scan_text"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
