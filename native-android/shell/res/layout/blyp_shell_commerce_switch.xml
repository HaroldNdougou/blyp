<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="12dp">

    <ImageView
        android:id="@+id/blyp_commerce_switch_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:contentDescription="@string/blyp_shell_scan_back"
        android:padding="12dp"
        android:src="@drawable/blyp_shell_ic_back" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/blyp_shell_commerce_switch_title"
        android:textColor="@color/blyp_shell_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/blyp_shell_commerce_switch_lead"
        android:textColor="@color/blyp_shell_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/blyp_commerce_switch_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/blyp_shell_commerce_switch_empty"
        android:textColor="@color/blyp_shell_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/blyp_commerce_switch_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <ProgressBar
        android:id="@+id/blyp_commerce_switch_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/blyp_commerce_switch_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/blyp_shell_commerce_open_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:text="@string/blyp_shell_commerce_create_open"
        android:textColor="@color/blyp_shell_accent"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
