<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/blyp_chat_money_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/blyp_shell_scan_back"
            android:padding="12dp"
            android:src="@drawable/blyp_shell_ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/blyp_shell_chat_money_title"
            android:textColor="@color/blyp_shell_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blyp_shell_border_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp">

        <EditText
            android:id="@+id/blyp_chat_money_amount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/blyp_shell_deposit_bg"
            android:gravity="center_vertical"
            android:hint="0"
            android:inputType="number"
            android:maxLength="7"
            android:paddingHorizontal="16dp"
            android:textColor="@color/blyp_shell_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/blyp_chat_money_q500"
                style="@style/BlypShellDepositQuick"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="500" />

            <TextView
                android:id="@+id/blyp_chat_money_q1000"
                style="@style/BlypShellDepositQuick"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="1000" />

            <TextView
                android:id="@+id/blyp_chat_money_q2000"
                style="@style/BlypShellDepositQuick"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="2000" />

            <TextView
                android:id="@+id/blyp_chat_money_q5000"
                style="@style/BlypShellDepositQuick"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="5000" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/blyp_shell_pay_motif_label"
            android:textColor="@color/blyp_shell_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/blyp_chat_money_motif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/blyp_shell_deposit_bg"
            android:gravity="top|start"
            android:hint="@string/blyp_shell_pay_motif_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="150"
            android:minHeight="72dp"
            android:minLines="2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/blyp_shell_text"
            android:textColorHint="@color/blyp_shell_muted"
            android:textSize="15sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/blyp_chat_money_motif_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/blyp_chat_money_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/blyp_shell_filter_chip_selected"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="@string/blyp_shell_chat_money_send"
            android:textColor="@color/blyp_shell_accent_on"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>