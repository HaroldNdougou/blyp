<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <ImageView
                android:id="@+id/blyp_settings_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/blyp_shell_scan_back"
                android:padding="12dp"
                android:src="@drawable/blyp_shell_ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/blyp_shell_settings_title"
                android:textColor="@color/blyp_shell_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/blyp_settings_avatar_frame"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/blyp_settings_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/blyp_cold_avatar"
                android:gravity="center"
                android:textColor="@color/blyp_shell_avatar_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/blyp_settings_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/blyp_shell_profile_avatar_a11y"
                android:scaleType="matrix"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/blyp_settings_change_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/blyp_shell_settings_change_photo"
            android:textColor="@color/blyp_shell_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/blyp_shell_settings_name_label"
            android:textColor="@color/blyp_shell_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/blyp_settings_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/blyp_shell_filter_chip"
            android:paddingHorizontal="16dp"
            android:textColor="@color/blyp_shell_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/blyp_shell_settings_theme_label"
            android:textColor="@color/blyp_shell_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/blyp_shell_settings_theme_hint"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/blyp_settings_theme_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/blyp_settings_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/blyp_shell_filter_chip_selected"
            android:gravity="center"
            android:text="@string/blyp_shell_settings_save"
            android:textColor="@color/blyp_shell_accent_on"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
