<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="56dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/blyp_chat_place_bubble"
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/blyp_shell_place_bubble"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/blyp_chat_place_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/blyp_shell_surface_muted"
                android:contentDescription="@string/blyp_shell_chat_place_here"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <TextView
            android:id="@+id/blyp_chat_place_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:text="@string/blyp_shell_chat_place_here"
            android:textColor="@color/blyp_shell_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blyp_chat_place_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/blyp_shell_text"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blyp_chat_place_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="12dp"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/blyp_chat_place_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="14dp"
            android:textColor="@color/blyp_shell_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
