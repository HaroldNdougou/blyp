<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/quick_pay_merchant_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/quick_pay_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/quick_pay_avatar_placeholder"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/quick_pay_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/quick_pay_merchant_name"
                android:background="@drawable/quick_pay_avatar_placeholder" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quick_pay_merchant_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="150dp"
                    android:maxLines="1"
                    android:textColor="@color/quick_pay_merchant_name"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quick_pay_merchant_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/quick_pay_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/quick_pay_chip_text"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/quick_pay_scan"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/quick_pay_scan_chip"
            android:padding="3dp"
            android:src="@drawable/quick_pay_ic_scan" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_pay_sum_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/quick_pay_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/quick_pay_merchant_name"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quick_pay_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:contentDescription="@string/quick_pay_clear"
            android:text="×"
            android:textColor="@color/quick_pay_chip_text"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quick_pay_pay"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/quick_pay_chip_selected"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/quick_pay_pay"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_pay_amounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/quick_pay_chip_50"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/quick_pay_amount_50"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/quick_pay_chip_default"
                android:gravity="center"
                android:text="50"
                android:textColor="@color/quick_pay_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quick_pay_count_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:paddingHorizontal="3dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/quick_pay_chip_100"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/quick_pay_amount_100"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/quick_pay_chip_default"
                android:gravity="center"
                android:text="100"
                android:textColor="@color/quick_pay_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quick_pay_count_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:paddingHorizontal="3dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/quick_pay_chip_500"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/quick_pay_amount_500"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/quick_pay_chip_default"
                android:gravity="center"
                android:text="500"
                android:textColor="@color/quick_pay_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quick_pay_count_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:paddingHorizontal="3dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/quick_pay_amount_other"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/quick_pay_chip_default"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/quick_pay_chip_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
