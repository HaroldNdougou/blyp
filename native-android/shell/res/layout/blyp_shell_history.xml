<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blyp_shell_bg"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:id="@+id/blyp_shell_history_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/blyp_shell_history_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blyp_shell_history_title"
            android:textColor="@color/blyp_shell_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blyp_shell_history_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/blyp_shell_history_subtitle_empty"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/blyp_shell_filter_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/blyp_shell_history_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/blyp_shell_history_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/blyp_shell_text"
                android:textColorHint="@color/blyp_shell_hint"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/blyp_shell_history_filter_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/blyp_shell_history_filter_a11y"
                android:padding="6dp"
                android:src="@drawable/blyp_shell_ic_filter" />
        </LinearLayout>

        <TextView
            android:id="@+id/blyp_shell_history_filter_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/blyp_shell_place_chip_on"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/blyp_shell_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/blyp_shell_history_shops_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/blyp_shell_history_shops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/blyp_shell_history_summary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/blyp_shell_summary_sent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/blyp_shell_summary_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/blyp_shell_summary_sent_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blyp_shell_history_summary_sent"
                    android:textAllCaps="true"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_shell_summary_sent_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/blyp_shell_history_fcfa"
                    android:textColor="@color/blyp_shell_text_faint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blyp_shell_summary_received"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/blyp_shell_summary_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/blyp_shell_summary_received_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blyp_shell_history_summary_received"
                    android:textAllCaps="true"
                    android:textColor="@color/blyp_shell_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_shell_summary_received_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/blyp_shell_success_amount"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/blyp_shell_history_fcfa"
                    android:textColor="@color/blyp_shell_text_faint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/blyp_shell_history_swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/blyp_shell_history_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingBottom="16dp"
                android:scrollbars="none" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/blyp_shell_history_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/blyp_shell_history_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/blyp_shell_history_empty"
                android:textColor="@color/blyp_shell_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/blyp_shell_history_empty_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/blyp_shell_filter_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:paddingVertical="12dp"
                android:text="@string/blyp_shell_history_empty_cta"
                android:textColor="@color/blyp_shell_accent_on"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
