<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/quick_pay_amount_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:contentDescription="@string/blyp_shell_scan_back"
        android:padding="12dp"
        android:src="@drawable/blyp_shell_ic_back" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/quick_pay_amount_title"
        android:textColor="@color/blyp_shell_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_pay_amount_input"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/quick_pay_amount_field"
        android:hint="@string/quick_pay_amount_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="7"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/blyp_shell_text"
        android:textColorHint="@color/blyp_shell_muted"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/quick_pay_amount_ok"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/blyp_shell_filter_chip_selected"
        android:gravity="center"
        android:text="@string/quick_pay_amount_validate"
        android:textColor="@color/blyp_shell_accent_on"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
