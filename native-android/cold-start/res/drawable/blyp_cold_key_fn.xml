<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/blyp_cold_start_keypad_pressed" />
            <stroke android:width="1dp" android:color="@color/blyp_cold_start_key_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/blyp_cold_start_keypad_fn" />
            <stroke android:width="1dp" android:color="@color/blyp_cold_start_key_border" />
        </shape>
    </item>
</selector>
