<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blyp_commerce_create_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blyp_shell_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/blyp_commerce_create_arrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/blyp_shell_scan_back"
            android:padding="12dp"
            android:src="@drawable/blyp_shell_ic_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/blyp_shell_commerce_create_title"
            android:textColor="@color/blyp_shell_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/blyp_shell_commerce_create_lead"
            android:textColor="@color/blyp_shell_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/blyp_shell_commerce_create_name_label"
            android:textColor="@color/blyp_shell_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/blyp_commerce_create_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/blyp_shell_menu_row_btn"
            android:hint="@string/blyp_shell_commerce_create_name_hint"
            android:inputType="textCapWords|textPersonName"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp"
            android:textColor="@color/blyp_shell_text"
            android:textColorHint="@color/blyp_shell_muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/blyp_shell_commerce_create_category_label"
            android:textColor="@color/blyp_shell_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/blyp_commerce_create_cat_taxi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/blyp_shell_commerce_chip_on"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/blyp_shell_commerce_cat_taxi"
                    android:textColor="@color/blyp_shell_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blyp_commerce_create_cat_soa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/blyp_shell_filter_chip"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/blyp_shell_commerce_cat_soa"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/blyp_commerce_create_cat_street"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/blyp_shell_filter_chip"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/blyp_shell_commerce_cat_street"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/blyp_commerce_create_cat_other"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/blyp_shell_filter_chip"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/blyp_shell_commerce_cat_other"
                    android:textColor="@color/blyp_shell_text"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/blyp_commerce_create_type_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/blyp_shell_commerce_create_type_label"
            android:textColor="@color/blyp_shell_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/blyp_commerce_create_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/blyp_shell_menu_row_btn"
            android:hint="@string/blyp_shell_commerce_create_type_hint"
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp"
            android:textColor="@color/blyp_shell_text"
            android:textColorHint="@color/blyp_shell_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blyp_commerce_create_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/blyp_shell_destructive"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blyp_commerce_create_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/blyp_shell_kyc_btn"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="@string/blyp_shell_commerce_create_cta"
            android:textColor="@color/blyp_shell_accent_on"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/blyp_commerce_create_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/blyp_shell_auth_cancel"
            android:textColor="@color/blyp_shell_accent"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/blyp_commerce_create_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
